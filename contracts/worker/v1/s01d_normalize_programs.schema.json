      "properties": {
        "output_directory": {
          "minLength": 1,
          "title": "Output Directory",
          "type": "string"
        },
        "program_pool_part_paths": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Program Pool Part Paths",
          "type": "array"
        },
        "shard_index": {
          "minimum": 0,
          "title": "Shard Index",
          "type": "integer"
        }
      },
      "required": [
        "program_pool_part_paths",
        "output_directory",
        "shard_index"
      ],
      "title": "S01dNormalizeProgramsRequest",
      "type": "object"
    },
    "S01dNormalizeProgramsResult": {
      "additionalProperties": false,
