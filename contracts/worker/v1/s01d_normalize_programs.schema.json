        "normalized_part_path": {
          "minLength": 1,
          "title": "Normalized Part Path",
          "type": "string"
        }
      },
      "required": [
        "normalized_part_path",
        "failure_part_path",
        "normalized_count",
        "failure_count",
        "normalization_version"
      ],
      "title": "S01dNormalizeProgramsResult",
      "type": "object"
    }
  },
  "$id": "https://github.com/MRiabov/CAD-QA/contracts/worker/v1/s01d_normalize_programs.schema.json",
