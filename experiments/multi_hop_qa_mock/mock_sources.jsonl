{"source_id":"src_mock_advanced_holes","source_family":"synthetic_cadevolve_style","source_ref":"cad_qa.fixtures.ADVANCED_HUMAN_NOTES_CODE","code_lines":["import cadquery as cq","","wp0 = cq.Workplane(\"XY\")","box_a = wp0.box(1, 2, 3)","box_b = cq.Workplane(\"XY\").box(4, 5, 6)","feature_after_box_2 = box_b.extrude(2)","hole_1_wp = feature_after_box_2.faces(\">Z\").workplane().center(-1.5, 0)","hole_1 = hole_1_wp.hole(1)","hole_2_wp = hole_1.faces(\">Z\").workplane().center(0, 0)","hole_2 = hole_2_wp.hole(1)","hole_3_wp = hole_2.faces(\">Z\").workplane().center(1.5, 0)","hole_3 = hole_3_wp.hole(1)","result = hole_3"],"mock_graph_summary":{"features":["box_a","box_b","feature_after_box_2","hole_1_wp","hole_1","hole_2_wp","hole_2","hole_3_wp","hole_3"],"stable_metrics":["signed_volume_delta","bbox_delta","topology_delta","axis_component_distance"],"mock_notes":["hole_1, hole_2, and hole_3 remove equal nonzero volume","hole_3 is the only hole whose setup center has positive X offset","all three holes leave the global bounding box unchanged"]}}
{"source_id":"src_mock_cadevolve_helix_boss","source_family":"CADEvolve-C-core/ArrayBossHelixWire","source_ref":"data/cadqa_cadevolve_rc_10 source src_34c0838fa7a13794","code_lines":["import cadquery as cq","wp1 = cq.Workplane('XY', origin=(0, 0, -89))","wp2 = wp1.splineApprox([[79, 0, 0], [69, 38, 7], [42, 66, 14], [5, 78, 21], [-33, 71, 29], [-64, 46, 36], [-78, 10, 43], [-73, -29, 50], [-50, -61, 57], [-15, -77, 64], [24, -75, 72], [57, -54, 79], [76, -20, 86], [76, 20, 93], [57, 54, 100], [24, 75, 107], [-15, 77, 114], [-50, 61, 122], [-73, 29, 129], [-78, -10, 136], [-64, -46, 143], [-33, -71, 150], [5, -78, 157], [42, -66, 164], [69, -38, 172], [79, 0, 179]], makeWire=1)","wp3 = cq.Workplane('XZ', origin=(0, 0, -89))","wp4 = wp3.moveTo(79, 0)","wp5 = wp4.circle(11)","wp6 = wp5.sweep(wp2)","wp7 = cq.Workplane(cq.Plane(origin=cq.Vector(28, 85, -71), xDir=cq.Vector(3, -1, 0), normal=cq.Vector(1, 3, 0)))","wp8 = wp7.circle(5)","wp9 = wp8.extrude(8)","wp10 = wp6.union(wp9)","wp11 = cq.Workplane(cq.Plane(origin=cq.Vector(-72, 53, -53), xDir=cq.Vector(-2, -2, 0), normal=cq.Vector(-2, 2, 0)))","wp12 = wp11.circle(5)","wp13 = wp12.extrude(8)","wp14 = wp10.union(wp13)","... repeated circular bosses omitted in this mock source view ...","wp35 = cq.Workplane(cq.Plane(origin=cq.Vector(28, -85, 72), xDir=cq.Vector(-3, -1, 0), normal=cq.Vector(1, -3, 0)))","wp36 = wp35.circle(5)","wp37 = wp36.extrude(8)","wp38 = wp34.union(wp37)","result = wp38"],"mock_graph_summary":{"features":["wp6","wp9","wp10","wp13","wp14","wp17","wp18","wp21","wp22","wp25","wp26","wp29","wp30","wp33","wp34","wp37","wp38"],"stable_metrics":["signed_volume_delta","bbox_extent_z","bbox_delta","topology_delta"],"mock_notes":["wp37 is the last circular boss extrusion before the final union","wp35 has the greatest Z coordinate among boss workplane origins","all boss extrusions use a circle of radius 5 and extrude distance 8"]}}
{"source_id":"src_mock_shapenet_star_slots","source_family":"CADEvolve-P/ShapeNet-P","source_ref":"data/cadqa_cadevolve_rc_10 source src_bb1d614881c83f67","code_lines":["import cadquery as cq","import math","A = 14.0","B = 26.0","C = 89.0","R_out = 4.0","R_in = 0.27","side_scale = 1.0","base = cq.Workplane(\"XY\").box(A, B, C)","def star_points(n=5, inner=R_in, scale=1.0):","    pts = []","    total = n * 2","    for k in range(total):","        ang = 2 * math.pi * k / total","        rad = 1.0 if (k % 2 == 0) else inner","        pts.append((math.cos(ang) * rad * scale, math.sin(ang) * rad * scale))","    return pts","front_shape = star_points()","side_shape = star_points()","for face_tag in (\">Y\", \"<Y\"):","    base = base.faces(face_tag).workplane().polyline(front_shape).close().cutThruAll()","for face_tag in (\">X\", \"<X\"):","    base = base.faces(face_tag).workplane().polyline(side_shape).close().cutThruAll()","th = R_out * R_in","dY = min(R_out, B / 2.0)","dX = min(R_out, A / 2.0)","zpos = R_out + th / 2.0","for z in (zpos, -zpos):","    base = base.faces(\">Y\").workplane().center(0, z).rect(A, th).cutBlind(-dY)","    base = base.faces(\">X\").workplane().center(0, z).rect(B, th).cutBlind(-dX)","result = base"],"mock_graph_summary":{"features":["base_box","front_star_cut_pos_y","front_star_cut_neg_y","side_star_cut_pos_x","side_star_cut_neg_x","slot_y_pos_upper_cut","slot_x_pos_upper_cut","slot_y_pos_lower_cut","slot_x_pos_lower_cut"],"stable_metrics":["signed_volume_delta","selector_result","bbox_delta","loop_expanded_order"],"mock_notes":["loop-expanded feature IDs are mock IDs for this experiment","slot_y_pos_upper_cut is the rectangular blind cut on the >Y face at positive z","the star cutThruAll operations are distractors because they are selector-driven cuts but not rectangular blind cuts"]}}
