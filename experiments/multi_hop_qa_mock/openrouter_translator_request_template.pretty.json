{
    "schema_version": "cadqa_openrouter_translator_request_template_v0",
    "purpose": "Initial OpenRouter call for the translator model. The user content should be one sanitized row from translator_input_packets.jsonl.",
    "endpoint": "https://openrouter.ai/api/v1/chat/completions",
    "auth_env": "OPENROUTER_API_KEY",
    "request": {
        "model": "OPENROUTER_TRANSLATOR_MODEL_ID",
        "temperature": 0.4,
        "max_tokens": 1200,
        "response_format": {
            "type": "json_object"
        },
        "messages": [
            {
                "role": "system",
                "content": "You are a CAD-QA question translator. Rewrite approved hidden CAD clues into a natural public benchmark question. Preserve all approved clues, do not add facts, do not reveal forbidden strings, and return only valid JSON matching the requested output_schema."
            },
            {
                "role": "user",
                "content": "TRANSLATOR_INPUT_PACKET_JSON_GOES_HERE"
            }
        ]
    },
    "metadata_to_store": {
        "role": "question_translator",
        "packet_version": "cadqa_translator_input_mock_v0",
        "model": "OPENROUTER_TRANSLATOR_MODEL_ID",
        "temperature": 0.4,
        "attempt": 1
    },
    "disabled_by_default": true,
    "critical_policy": {
        "must_not_send": [
            "gold_answer",
            "answer",
            "predicate",
            "candidate_ids_after_clause",
            "evidence_chain",
            "distractors",
            "verifier_status"
        ],
        "must_send": [
            "public_source_code",
            "render_request",
            "approved_clues",
            "forbidden_question_strings",
            "output_schema"
        ]
    }
}
