{
  "schema_version": "cadqa_openrouter_request_template_v0",
  "purpose": "Template for later live solver or judge calls. Do not use until model IDs and cost limits are reviewed.",
  "endpoint": "https://openrouter.ai/api/v1/chat/completions",
  "auth_env": "OPENROUTER_API_KEY",
  "request": {
    "model": "OPENROUTER_MODEL_ID",
    "temperature": 0,
    "max_tokens": 512,
    "messages": [
      {
        "role": "system",
        "content": "You answer CAD-QA benchmark questions. Return only the requested answer unless explicitly asked for rationale."
      },
      {
        "role": "user",
        "content": "SAMPLE_PROMPT_GOES_HERE"
      }
    ]
  },
  "metadata_to_store": {
    "sample_id": "mhqa_mock_001",
    "role": "solver",
    "model": "OPENROUTER_MODEL_ID",
    "prompt_version": "mock_public_samples_v0",
    "temperature": 0,
    "attempt": 1
  },
  "disabled_by_default": true
}
