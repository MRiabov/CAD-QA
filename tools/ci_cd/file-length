#!/usr/bin/env bash
# File-length gate. Scans the whole repository, so it takes well under a second;
# run it from anywhere. See docs/dataset/implementation/file-trees.md.
#
# Usage: tools/ci_cd/file-length [--quiet]
set -euo pipefail
cd "$(dirname "$0")/../.."
exec uv run python tools/ci_cd/check_file_length.py "$@"
