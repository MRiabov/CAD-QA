#!/usr/bin/env bash
# Don't-say checker. Scans the whole repository, so it takes about a second;
# run it from anywhere. See docs/docs-conventions.md.
#
# Usage: tools/ci_cd/dont-say [--ratchet tools/ci_cd/dont_say_baseline.txt]
#                                   [--names-ratchet tools/ci_cd/dont_say_names_baseline.txt]
#                                   [--quiet]
set -euo pipefail
cd "$(dirname "$0")/../.."
exec uv run python tools/ci_cd/check_dont_say.py "$@"
