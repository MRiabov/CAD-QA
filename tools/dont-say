#!/usr/bin/env bash
# Don't-say checker. Scans the whole repository, so it takes about a second;
# run it from anywhere. See docs/docs-conventions.md.
#
# Usage: tools/dont-say [--ratchet tools/dont_say_baseline.txt] [--quiet]
set -euo pipefail
cd "$(dirname "$0")/.."
exec uv run python tools/check_dont_say.py "$@"
